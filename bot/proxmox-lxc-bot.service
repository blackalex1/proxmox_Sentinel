[Unit]
Description=Proxmox LXC Monitor Telegram Bot Service
After=network-online.target pve-cluster.service pvedaemon.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/proxmox-lxc-bot/bot
ExecStart=/opt/proxmox-lxc-bot/bot/venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=proxmox-lxc-bot

[Install]
WantedBy=multi-user.target
